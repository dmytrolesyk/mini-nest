{
  "name": "@dmytrolesyk/custom-nest",
  "version": "0.1.0",
  "description": "A minimal IoC container with decorator-driven constructor injection",
  "keywords": [
    "ioc",
    "di",
    "dependency-injection",
    "container",
    "decorators",
    "reflect-metadata"
  ],
  "type": "module",
  "homepage": "https://github.com/dmytrolesyk/mini-nest#readme",
  "bugs": {
    "url": "https://github.com/dmytrolesyk/mini-nest/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dmytrolesyk/mini-nest.git"
  },
  "license": "ISC",
  "author": "Dmytro Lesyk",
  "main": "./dist/index.js",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "build:test": "rm -rf dist-test && tsc",
    "test": "pnpm build:test && node --test \"dist-test/test/*.test.js\"",
    "dev": "tsc -p tsconfig.dev.json && (tsc -p tsconfig.dev.json --watch --preserveWatchOutput & node --watch dist-dev/app.js)",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm test && pnpm build"
  },
  "packageManager": "pnpm@10.24.0",
  "devDependencies": {
    "@types/node": "^26.3.0",
    "reflect-metadata": "^0.2.2",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "peerDependencies": {
    "reflect-metadata": "^0.2.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1"
  }
}
